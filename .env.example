# Copy this file to .env and fill in values before running docker compose.
# All services that connect to infrastructure read credentials from this file.

# ── Infrastructure credentials ────────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_in_production
MONGO_ROOT_PASSWORD=change_me_in_production
REDIS_PASSWORD=change_me_in_production
KEYCLOAK_ADMIN_PASSWORD=change_me_in_production
KC_DB_PASSWORD=change_me_in_production

# RabbitMQ broker password.
# Must match the RabbitMQ appsettings Password value in:
#   ticket-notification-service, ticket-order-worker, ticket-payment-worker
# For local development set this to: change_me_in_production
RABBITMQ_PASSWORD=change_me_in_production

KAFKA_CLUSTER_ID=0-T2tUHNQJ-LTFhpc1OpAg

# ── Keycloak hostname (non-secret) ────────────────────────────────────────────
KC_HOSTNAME=localhost
KC_HOSTNAME_URL=http://localhost:8080

# ── Application service secrets ───────────────────────────────────────────────
# PostgreSQL ticket application user (created by postgres/init.sh at first start).
# Used by every service that connects to the ticket database.
TICKET_DB_PASSWORD=change_me_in_production

# Webhook HMAC-SHA256 signing secret (payment provider → ticket-payment-service).
PAYMENT_WEBHOOK_SECRET=change_me_in_production

# Keycloak OAuth2 client secrets — must match realm-export.json.
KEYCLOAK_GATEWAY_CLIENT_SECRET=change_me_in_production
KEYCLOAK_ADMIN_CLIENT_SECRET=change_me_in_production
KEYCLOAK_ORDER_SERVICE_CLIENT_SECRET=change_me_in_production
KEYCLOAK_ORDER_WORKER_CLIENT_SECRET=change_me_in_production

# Grafana
GRAFANA_ADMIN_PASSWORD=admin
